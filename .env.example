# Copia para .env.local (nunca faças commit deste ficheiro preenchido).
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>   # pública por desenho: a segurança está no RLS

# SÓ no servidor (Route Handlers/Edge Functions). NUNCA com prefixo NEXT_PUBLIC_, nunca no browser.
# Supabase > Project Settings > API > service_role. Usada só pelo recetor de eventos do Paddle,
# para gravar o estado de faturação (nenhum utilizador normal tem permissão para o fazer).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Faturação (Paddle) — cobra ÀS EMPRESAS que usam o Balcão, não é o mesmo que os pagamentos
# que essas empresas recebem dos seus próprios clientes.
# Paddle > Developer Tools > Authentication (client-side token: começa por "test_" em sandbox)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<client-side token>
# Paddle > Catalog > Prices — o preço da assinatura mensal do Balcão
NEXT_PUBLIC_PADDLE_PRICE_ID=<price id>
# "sandbox" (predefinição, para testar) ou "production"
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle > Developer Tools > Notifications > (o teu destino de webhook) > Secret key
PADDLE_WEBHOOK_SECRET=<webhook secret>
